{
  "name": "saregama",
  "version": "1.0.0",
  "description": "SAREGAMA Music App",
  "scripts": {
    "install": "npm install --prefix backend && npm install --prefix frontend",
    "build": "npm run build --prefix frontend",
    "start": "node backend/index.js",
    "dev": "concurrently \"npm run dev --prefix frontend\" \"node backend/index.js\""
  },
  "dependencies": {
    "concurrently": "^8.2.2"
  }
}
